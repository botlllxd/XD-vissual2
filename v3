local isMenuOpen = false
local function ToggleMenu()
    isMenuOpen = not isMenuOpen
    if isMenuOpen then
        MainFrame.Visible = true
        Body.Visible = true
        HeaderBottom.Visible = true
        GearBtn.Visible = true
        SettingsOverlay.Visible = false
        Sidebar.Visible = true
        ContentContainer.Visible = true
        TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 560, 0, 420),
            Position = UDim2.new(0.5, 0, 0.5, 210)
        }):Play()
    else
        GearBtn.Visible = false
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 200, 0, 45),
            Position = UDim2.new(0.5, 0, 1, -15)
        }):Play()
        task.delay(0.2, function()
            if not isMenuOpen then
                Body.Visible = false
                HeaderBottom.Visible = false
            end
        end)
    end
end

-- Перетаскивание (всегда)
local dragging, dragInput, dragStartPos, dragStartFramePos
local touchStartTime = 0
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragStartPos = input.Position
        touchStartTime = os.clock()
        dragging = true
        dragStartFramePos = MainFrame.Position
    end
end)
Header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        if dragStartPos and (input.Position - dragStartPos).Magnitude < 15 and (os.clock() - touchStartTime) < 0.3 then
            ToggleMenu()
        end
    end
end)
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStartPos
        MainFrame.Position = UDim2.new(
            dragStartFramePos.X.Scale, dragStartFramePos.X.Offset + delta.X,
            dragStartFramePos.Y.Scale, dragStartFramePos.Y.Offset + delta.Y
        )
    end
end))
table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

-- Открытие по RightShift и F1
table.insert(connections, UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.F1 then
        ToggleMenu()
    end
end))

