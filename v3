RunService:BindToRenderStep("XDFOV", Enum.RenderPriority.Last.Value, function()
    if FOVEnabled then
        local cam = workspace.CurrentCamera
        if cam then cam.FieldOfView = FOV end
    end
end)

RunService:BindToRenderStep("XDStretch", Enum.RenderPriority.Last.Value, function()
    if StretchEnabled then
        local cam = workspace.CurrentCamera
        if not cam then return end
        local presetToScale = {
            ["16:9 (Default)"] = 1.0,
            ["16:10"] = 0.9,
            ["4:3"] = 0.75,
            ["5:4"] = 0.703,
            ["3:4"] = 0.422,
            ["Custom"] = 1.0
        }
        local ratio
        if StretchPreset == "Custom" then
            ratio = StretchCustom / 100
        else
            ratio = presetToScale[StretchPreset] or 1.0
        end
        if ratio ~= 1 then
            local camCF = cam.CFrame
            if camCF.XVector.Magnitude > 0 and camCF.YVector.Magnitude > 0 then
                local cleanCF = CFrame.fromMatrix(camCF.Position, camCF.XVector.Unit, camCF.YVector.Unit, camCF.ZVector.Unit)
                cam.CFrame = cleanCF * CFrame.new(0, 0, 0, 1, 0, 0, 0, ratio, 0, 0, 0, 1)
            end
        end
    end
end)

