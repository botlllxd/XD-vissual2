local SaveKey = "XD_Visuals_Settings"
local function SaveSettings(data)
    pcall(function()
        local json = HttpService:JSONEncode(data)
        ScreenGui:SetAttribute(SaveKey, json)
    end)
end
local function LoadSettings()
    local json = ScreenGui:GetAttribute(SaveKey)
    if json and json ~= "" then
        local success, result = pcall(function() return HttpService:JSONDecode(json) end)
        if success and type(result) == "table" then return result end
    end
    return nil
end

