-- ====== НАСТРОЙКИ UI (шестерёнка) ======
local function CreateUIControls()
    -- === UI Theme ===
    local label = Instance.new("TextLabel", SettingsOverlay)
    label.Size = UDim2.new(0, 350, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = "=== UI Theme ==="
    label.TextColor3 = TextColor
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Center

    local function sliderColor(text, keyR, keyG, keyB, defaultR, defaultG, defaultB)
        CreateSlider(SettingsOverlay, text .. " R", 0, 255, Settings[keyR], function(val) Settings[keyR] = val; saveState(); ApplyTheme() end)
        CreateSlider(SettingsOverlay, text .. " G", 0, 255, Settings[keyG], function(val) Settings[keyG] = val; saveState(); ApplyTheme() end)
        CreateSlider(SettingsOverlay, text .. " B", 0, 255, Settings[keyB], function(val) Settings[keyB] = val; saveState(); ApplyTheme() end)
    end

    sliderColor("Main", "AccentR", "AccentG", "AccentB", 255, 255, 255)

    CreateToggle(SettingsOverlay, "Enable Gradient", Settings.GradientEnabled, function(val)
        Settings.GradientEnabled = val; saveState(); ApplyTheme()
    end)

    sliderColor("Second", "SecondR", "SecondG", "SecondB", 0, 0, 0)

    local resetBtn = Instance.new("TextButton", SettingsOverlay)
    resetBtn.Size = UDim2.new(0, 120, 0, 30)
    resetBtn.BackgroundColor3 = BgElement
    resetBtn.Text = "Reset to White"
    resetBtn.TextColor3 = TextColor
    resetBtn.TextSize = 12
    resetBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", resetBtn).CornerRadius = UDim.new(0, 6)
    resetBtn.MouseButton1Click:Connect(function()
        Settings.AccentR = 255; Settings.AccentG = 255; Settings.AccentB = 255
        Settings.GradientEnabled = false
        Settings.SecondR = 0; Settings.SecondG = 0; Settings.SecondB = 0
        saveState(); ApplyTheme()
    end)
end

CreateUIControls()

