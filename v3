    local footprintConn = RunService.Heartbeat:Connect(function()
        if character and character:IsDescendantOf(workspace) then
            UpdateFootprints(character)
        else
            footprintConn:Disconnect()
        end
    end)
    table.insert(connections, footprintConn)
    applyPCEffects()
end

