local _applying = false
local function applyEnvironmentSettings()
    if _applying then return end
    _applying = true
    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") or obj:IsA("Clouds") then obj:Destroy() end
    end
    if SkyboxEnabled and CurrentPreset ~= "Default" then
        local preset = SkyboxPresets[CurrentPreset]
        if preset then
            local currentSky = Lighting:FindFirstChildOfClass("Sky")
            if currentSky then if currentSky.SkyboxBk ~= preset.SkyboxBk then currentSky:Destroy() currentSky = nil end end
            if not currentSky then currentSky = Instance.new("Sky") currentSky.Parent = Lighting end
            currentSky.SkyboxBk = preset.SkyboxBk; currentSky.SkyboxDn = preset.SkyboxDn; currentSky.SkyboxFt = preset.SkyboxFt
            currentSky.SkyboxLf = preset.SkyboxLf; currentSky.SkyboxRt = preset.SkyboxRt; currentSky.SkyboxUp = preset.SkyboxUp
            currentSky.StarCount = 1000; currentSky.SunAngularSize = 11; currentSky.MoonAngularSize = 11; currentSky.CelestialBodiesShown = true
            if CustomFogEnabled then currentSky.CelestialBodiesShown = false end
            Lighting.Brightness = preset.Brightness
            Lighting.ExposureCompensation = preset.Exposure
            Lighting.Ambient = preset.Ambient
            Lighting.OutdoorAmbient = preset.Outdoor
            Lighting.ColorShift_Top = preset.Top
            Lighting.ColorShift_Bottom = preset.Bottom
            if WorldTimeLock then
                Lighting.ClockTime = WorldTimeValue
            elseif not AutoTimeCycleEnabled then
                Lighting.ClockTime = preset.ClockTime
            end
        end
    else
        for _, obj in pairs(Lighting:GetChildren()) do if obj:IsA("Sky") then obj:Destroy() end end
        if ManualColorsEnabled then
            Lighting.Brightness = (SkyBrightness / 100) * 2 + 0.5; Lighting.ExposureCompensation = (SkyExposure / 100) * 4 - 2
            Lighting.Ambient = Color3.fromRGB(SkyR, SkyG, SkyB):Lerp(Color3.fromRGB(0,0,0), 0.5)
            Lighting.OutdoorAmbient = Color3.fromRGB(HorR, HorG, HorB)
            Lighting.ColorShift_Top = Color3.fromRGB(SkyR, SkyG, SkyB); Lighting.ColorShift_Bottom = Color3.fromRGB(HorR, HorG, HorB)
        else
            Lighting.Brightness = DefaultLighting.Brightness; Lighting.ExposureCompensation = DefaultLighting.ExposureCompensation
            Lighting.Ambient = DefaultLighting.Ambient; Lighting.OutdoorAmbient = DefaultLighting.OutdoorAmbient
            Lighting.ColorShift_Top = DefaultLighting.ColorShift_Top; Lighting.ColorShift_Bottom = DefaultLighting.ColorShift_Bottom
        end
        if WorldTimeLock then
            Lighting.ClockTime = WorldTimeValue
        elseif not AutoTimeCycleEnabled then
            Lighting.ClockTime = DefaultLighting.ClockTime
        end
    end
    if CustomFogEnabled then Lighting.FogStart = 0; Lighting.FogEnd = FogEndDist; Lighting.FogColor = FogColorRGB
    else Lighting.FogStart = DefaultLighting.FogStart; Lighting.FogEnd = DefaultLighting.FogEnd; Lighting.FogColor = DefaultLighting.FogColor end
    if not SkyboxEnabled and not ManualColorsEnabled then Lighting.Brightness = WorldBrightness; Lighting.ExposureCompensation = WorldExposure end
    Lighting.GlobalShadows = ShadowsEnabled
    _applying = false
end

Lighting.Changed:Connect(function(prop)
    if _applying then return end
    if SkyboxEnabled and CurrentPreset ~= "Default" then
        local preset = SkyboxPresets[CurrentPreset]
        if preset then
            if prop == "ClockTime" then
                if WorldTimeLock then Lighting.ClockTime = WorldTimeValue return end
                if AutoTimeCycleEnabled then return end
                if Lighting.ClockTime ~= preset.ClockTime then Lighting.ClockTime = preset.ClockTime end
                return
            end
            if prop == "Brightness" and Lighting.Brightness ~= preset.Brightness then Lighting.Brightness = preset.Brightness
            elseif prop == "ExposureCompensation" and Lighting.ExposureCompensation ~= preset.Exposure then Lighting.ExposureCompensation = preset.Exposure
            elseif prop == "Ambient" and Lighting.Ambient ~= preset.Ambient then Lighting.Ambient = preset.Ambient
            elseif prop == "OutdoorAmbient" and Lighting.OutdoorAmbient ~= preset.Outdoor then Lighting.OutdoorAmbient = preset.Outdoor
            elseif prop == "ColorShift_Top" and Lighting.ColorShift_Top ~= preset.Top then Lighting.ColorShift_Top = preset.Top
            elseif prop == "ColorShift_Bottom" and Lighting.ColorShift_Bottom ~= preset.Bottom then Lighting.ColorShift_Bottom = preset.Bottom
            end
        end
    end
    if CustomFogEnabled then
        if prop == "FogStart" and Lighting.FogStart ~= 0 then Lighting.FogStart = 0
        elseif prop == "FogEnd" and Lighting.FogEnd ~= FogEndDist then Lighting.FogEnd = FogEndDist
        elseif prop == "FogColor" and Lighting.FogColor ~= FogColorRGB then Lighting.FogColor = FogColorRGB end
    end
    if WorldTimeLock and prop == "ClockTime" then Lighting.ClockTime = WorldTimeValue end
end)

Lighting.ChildRemoved:Connect(function(child)
    if _applying then return end
    if SkyboxEnabled and child:IsA("Sky") then applyEnvironmentSettings() end
    if (BloomEnabled or ColorCorrectionEnabled or SunRaysEnabled or RTXEnabled) and
        (child:IsA("BloomEffect") or child:IsA("ColorCorrectionEffect") or child:IsA("SunRaysEffect")) then
        applyPCEffects()
    end
end)

-- ====== PC EFFECTS ======
local function applyPCEffects()
    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("BloomEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect") then
            pcall(function() obj:Destroy() end)
        end
    end

    if RTXEnabled then
        local bloom = Instance.new("BloomEffect"); bloom.Intensity = 0.8; bloom.Size = 40; bloom.Threshold = 0.7
        bloom.Parent = Lighting
        local cc = Instance.new("ColorCorrectionEffect"); cc.Brightness = 0.05; cc.Contrast = 0.2; cc.Saturation = 0.15
        cc.Parent = Lighting
        local sr = Instance.new("SunRaysEffect"); sr.Intensity = 0.5; sr.Spread = 0.6
        sr.Parent = Lighting
    else
        if BloomEnabled then
            local bloom = Instance.new("BloomEffect"); bloom.Intensity = BloomIntensity; bloom.Size = BloomSize; bloom.Threshold = BloomThreshold
            bloom.Parent = Lighting
        end
        if ColorCorrectionEnabled then
            local cc = Instance.new("ColorCorrectionEffect"); cc.Brightness = CCBrightness; cc.Contrast = CCContrast; cc.Saturation = CCSaturation
            cc.Parent = Lighting
        end
        if SunRaysEnabled then
            local sr = Instance.new("SunRaysEffect"); sr.Intensity = SunRaysIntensity; sr.Spread = SunRaysSpread
            sr.Parent = Lighting
        end
    end
end

-- ====== WATCHDOG ======
local function startShaderWatchdog()
    task.spawn(function()
        while true do
            task.wait(2)
            if not (BloomEnabled or ColorCorrectionEnabled or SunRaysEnabled or RTXEnabled) then continue end
            local hasBloom = Lighting:FindFirstChildOfClass("BloomEffect")
            local hasCC = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
            local hasSR = Lighting:FindFirstChildOfClass("SunRaysEffect")
            if (BloomEnabled or RTXEnabled) and not hasBloom then applyPCEffects() continue end
            if (ColorCorrectionEnabled or RTXEnabled) and not hasCC then applyPCEffects() continue end
            if (SunRaysEnabled or RTXEnabled) and not hasSR then applyPCEffects() continue end
        end
    end)
end

-- ====== AUTO TIME CYCLE ======
local function StartAutoTimeCycle()
    task.spawn(function()
        while true do
            if AutoTimeCycleEnabled and not WorldTimeLock then
                local current = Lighting.ClockTime
                current = (current + TimeCycleSpeed * 0.1) % 24
                Lighting.ClockTime = current
                task.wait(0.2)
            else
                task.wait(1)
            end
        end
    end)
end

