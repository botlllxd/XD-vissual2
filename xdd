local function CreateSlider(parent, text, min, max, default, callback)
    local Frame = Instance.new("Frame", parent)
    Frame.Size = UDim2.new(0, 350, 0, 60)
    Frame.BackgroundColor3 = BgElement
    Frame.BorderSizePixel = 0
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel", Frame)
    Label.Size = UDim2.new(1, -24, 0, 20)
    Label.Position = UDim2.new(0, 12, 0, 6)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. tostring(default)
    Label.TextColor3 = TextColor
    Label.TextSize = 13
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local SliderBar = Instance.new("Frame", Frame)
    SliderBar.Size = UDim2.new(1, -24, 0, 4)
    SliderBar.Position = UDim2.new(0, 12, 0, 34)
    SliderBar.BackgroundColor3 = Color3.fromRGB(45, 45, 48)
    SliderBar.BorderSizePixel = 0
    Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(0, 2)

    local Fill = Instance.new("Frame", SliderBar)
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = AccentColor
    Fill.BorderSizePixel = 0
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 2)

    local Button = Instance.new("TextButton", Frame)
    Button.Size = UDim2.new(0, 14, 0, 14)
    Button.Position = UDim2.new(0, 12 + (Fill.Size.X.Scale * (350-24)) - 7, 0, 29)
    Button.BackgroundColor3 = AccentColor
    Button.Text = ""
    Button.BorderSizePixel = 0
    Instance.new("UICorner", Button).CornerRadius = UDim.new(1, 0)
    Button.ZIndex = 2

    local isDragging = false
    local function updateValue(inputX)
        local barAbsPos = SliderBar.AbsolutePosition.X
        local barWidth = SliderBar.AbsoluteSize.X
        local relativeX = math.clamp(inputX - barAbsPos, 0, barWidth)
        local fraction = relativeX / barWidth
        local value = math.floor(min + (max - min) * fraction + 0.5)
        value = math.clamp(value, min, max)
        Label.Text = text .. ": " .. tostring(value)
        Fill.Size = UDim2.new(fraction, 0, 1, 0)
        Button.Position = UDim2.new(0, 12 + fraction * (350-24) - 7, 0, 29)
        callback(value)
    end

    Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = true end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateValue(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
    end)
    Button.MouseButton1Down:Connect(function() updateValue(UserInputService:GetMouseLocation().X) end)
end

-- ================== PERSISTENT ENVIRONMENT LOGIC ==================
local _applying = false

local function applyEnvironmentSettings()
    if _applying then return end
    _applying = true

    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") or obj:IsA("Clouds") then obj:Destroy() end
    end

    if SkyboxEnabled then
        local preset = SkyboxPresets[CurrentPreset]
        if preset then
            local currentSky = Lighting:FindFirstChildOfClass("Sky")
            if currentSky then
                if currentSky.SkyboxBk ~= preset.SkyboxBk then
                    currentSky:Destroy()
                    currentSky = nil
                end
            end
            if not currentSky then
                currentSky = Instance.new("Sky")
                currentSky.Parent = Lighting
            end
            currentSky.SkyboxBk = preset.SkyboxBk
            currentSky.SkyboxDn = preset.SkyboxDn
            currentSky.SkyboxFt = preset.SkyboxFt
            currentSky.SkyboxLf = preset.SkyboxLf
            currentSky.SkyboxRt = preset.SkyboxRt
            currentSky.SkyboxUp = preset.SkyboxUp
            currentSky.StarCount = SkySettings.StarCount
            currentSky.SunAngularSize = SkySettings.SunAngularSize
            currentSky.MoonAngularSize = SkySettings.MoonAngularSize
            currentSky.CelestialBodiesShown = SkySettings.CelestialBodiesShown

            if CustomFogEnabled then currentSky.CelestialBodiesShown = false end

            Lighting.ClockTime = preset.ClockTime
            Lighting.Brightness = preset.Brightness
            Lighting.ExposureCompensation = preset.Exposure
            Lighting.Ambient = preset.Ambient
            Lighting.OutdoorAmbient = preset.Outdoor
            Lighting.ColorShift_Top = preset.Top
            Lighting.ColorShift_Bottom = preset.Bottom
        end
    else
        for _, obj in pairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") then obj:Destroy() end
        end
        if ManualColorsEnabled then
            Lighting.Brightness = (SkyBrightness / 100) * 2 + 0.5
            Lighting.ExposureCompensation = (SkyExposure / 100) * 4 - 2
            Lighting.Ambient = Color3.fromRGB(SkyR, SkyG, SkyB):Lerp(Color3.fromRGB(0,0,0), 0.5)
            Lighting.OutdoorAmbient = Color3.fromRGB(HorR, HorG, HorB)
            Lighting.ColorShift_Top = Color3.fromRGB(SkyR, SkyG, SkyB)
            Lighting.ColorShift_Bottom = Color3.fromRGB(HorR, HorG, HorB)
        else
            Lighting.Brightness = DefaultLighting.Brightness
            Lighting.ExposureCompensation = DefaultLighting.ExposureCompensation
            Lighting.Ambient = DefaultLighting.Ambient
            Lighting.OutdoorAmbient = DefaultLighting.OutdoorAmbient
            Lighting.ColorShift_Top = DefaultLighting.ColorShift_Top
            Lighting.ColorShift_Bottom = DefaultLighting.ColorShift_Bottom
        end
        Lighting.ClockTime = DefaultLighting.ClockTime
    end

    if CustomFogEnabled then
        Lighting.FogStart = 0
        Lighting.FogEnd = FogEndDist
        Lighting.FogColor = FogColorRGB
    else
        Lighting.FogStart = DefaultLighting.FogStart
        Lighting.FogEnd = DefaultLighting.FogEnd
        Lighting.FogColor = DefaultLighting.FogColor
    end

    if WorldTimeLock then Lighting.ClockTime = WorldTimeValue end
    if not SkyboxEnabled and not ManualColorsEnabled then
        Lighting.Brightness = WorldBrightness
        Lighting.ExposureCompensation = WorldExposure
    end

    _applying = false
end

-- Защита от сброса
Lighting.Changed:Connect(function(prop)
    if _applying then return end
    if SkyboxEnabled then
        local preset = SkyboxPresets[CurrentPreset]
        if preset then
            if prop == "ClockTime" and Lighting.ClockTime ~= preset.ClockTime then Lighting.ClockTime = preset.ClockTime
            elseif prop == "Brightness" and Lighting.Brightness ~= preset.Brightness then Lighting.Brightness = preset.Brightness
            elseif prop == "ExposureCompensation" and Lighting.ExposureCompensation ~= preset.Exposure then Lighting.ExposureCompensation = preset.Exposure
            elseif prop == "Ambient" and Lighting.Ambient ~= preset.Ambient then Lighting.Ambient = preset.Ambient
            elseif prop == "OutdoorAmbient" and Lighting.OutdoorAmbient ~= preset.Outdoor then Lighting.OutdoorAmbient = preset.Outdoor
            elseif prop == "ColorShift_Top" and Lighting.ColorShift_Top ~= preset.Top then Lighting.ColorShift_Top = preset.Top
            elseif prop == "ColorShift_Bottom" and Lighting.ColorShift_Bottom ~= preset.Bottom then Lighting.ColorShift_Bottom = preset.Bottom
            end
        end
    end
    if CustomFogEnabled then
        if prop == "FogStart" and Lighting.FogStart ~= 0 then Lighting.FogStart = 0
        elseif prop == "FogEnd" and Lighting.FogEnd ~= FogEndDist then Lighting.FogEnd = FogEndDist
        elseif prop == "FogColor" and Lighting.FogColor ~= FogColorRGB then Lighting.FogColor = FogColorRGB
        end
    end
    if WorldTimeLock and prop == "ClockTime" then Lighting.ClockTime = WorldTimeValue end
end)

Lighting.ChildRemoved:Connect(function(child)
    if _applying then return end
    if SkyboxEnabled and child:IsA("Sky") then applyEnvironmentSettings() end
end)

Lighting.ChildAdded:Connect(function(child)
    if _applying then return end
    if SkyboxEnabled and child:IsA("Sky") then applyEnvironmentSettings() end
end)

-- ================== PARTICLES SYSTEM (ANGEL WINGS AURA) ==================
local WingEmitter = nil

local function UpdateWings()
    if WingEmitter then WingEmitter:Destroy() WingEmitter = nil end
    if not WingsEnabled or not LocalPlayer.Character then return end

    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    WingEmitter = Instance.new("ParticleEmitter")
    WingEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    WingEmitter.Color = ColorSequence.new(WingsColor)
    WingEmitter.Size = NumberSequence.new(0.5, 1.2)
    WingEmitter.Lifetime = NumberRange.new(0.8, 1.5)
    WingEmitter.Rate = 80
    WingEmitter.Speed = NumberRange.new(2, 4)
    WingEmitter.SpreadAngle = Vector2.new(360, 360)
    WingEmitter.VelocityInheritance = 0.5
    WingEmitter.Parent = root
    WingEmitter.Enabled = true
end

-- ================== JUMP WAVE SYSTEM (ENHANCED) ==================
local JumpWaveEmitters = {}

local function CreateJumpWave(position)
    local attachment = Instance.new("Attachment")
    attachment.WorldPosition = position
    attachment.Parent = workspace.Terrain

    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(JumpWaveColor)
    emitter.Size = NumberSequence.new(1.5, 2.5)       -- очень крупные частицы
    emitter.Lifetime = NumberRange.new(0.6, 1.2)      -- длительность жизни
    emitter.Rate = 40                                -- много частиц
    emitter.Speed = NumberRange.new(5, 12)             -- быстрый разлёт
    emitter.SpreadAngle = Vector2.new(360, 360)        -- во все стороны
    emitter.EmissionDirection = Enum.NormalId.Top      -- вверх и в стороны
    emitter.VelocityInheritance = 0
    emitter.Parent = attachment
    emitter.Enabled = true

    table.insert(JumpWaveEmitters, {attachment = attachment, emitter = emitter})

    task.delay(1.5, function()
        if attachment then attachment:Destroy() end
        if emitter then emitter:Destroy() end
    end)
end

local function SetupJumpDetection(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local jumpingConn
    jumpingConn = humanoid.Jumping:Connect(function()
        if not JumpWaveEnabled then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = root.Position - Vector3.new(0, 3, 0) -- у ног
            CreateJumpWave(pos)
        end
    end)
    table.insert(connections, jumpingConn)
end

-- ================== CHARACTER HANDLING ==================
local function OnCharacterAdded(character)
    task.wait(1)
    if WingsEnabled then UpdateWings() end
    SetupJumpDetection(character)
end

if LocalPlayer then
    LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
    if LocalPlayer.Character then
        task.spawn(OnCharacterAdded, LocalPlayer.Character)
    end
end

