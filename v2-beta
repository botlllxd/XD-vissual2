    WingEmitter.VelocityInheritance = 0.5
    WingEmitter.Parent = root
    WingEmitter.Enabled = true
end

local JumpWaveEmitters = {}
local function CreateJumpWave(position)
    local attachment = Instance.new("Attachment")
    attachment.WorldPosition = position
    attachment.Parent = workspace.Terrain
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(JumpWaveColor)
    emitter.Size = NumberSequence.new(1.5, 2.5)
    emitter.Lifetime = NumberRange.new(0.6, 1.2)
    emitter.Rate = 300
    emitter.Speed = NumberRange.new(5, 12)
    emitter.SpreadAngle = Vector2.new(360, 360)
    emitter.EmissionDirection = Enum.NormalId.Top
    emitter.VelocityInheritance = 0
    emitter.Parent = attachment
    emitter.Enabled = true
    table.insert(JumpWaveEmitters, {attachment = attachment, emitter = emitter})
    task.delay(1.5, function()
        if attachment then attachment:Destroy() end
        if emitter then emitter:Destroy() end
    end)
end

local function SetupJumpDetection(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local jumpingConn = humanoid.Jumping:Connect(function()
        if not JumpWaveEnabled then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            CreateJumpWave(root.Position - Vector3.new(0, 3, 0))
        end
    end)
    table.insert(connections, jumpingConn)
end

local FootprintEmitters = {}
local lastFootprintTime = 0
local FootprintTextures = {
    ["Sparkles"] = "rbxasset://textures/particles/sparkles_main.dds",
    ["Paw"] = "rbxassetid://6251240361",
    ["Star"] = "rbxassetid://13543916053",
    ["WaterDrop"] = "rbxasset://textures/particles/drop.png"
}

local function CreateFootprint(position)
    local attachment = Instance.new("Attachment")
    attachment.WorldPosition = position
    attachment.Parent = workspace.Terrain
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = FootprintTextures[FootprintTexture] or FootprintTextures["Sparkles"]
    emitter.Color = ColorSequence.new(FootprintColor)
    emitter.Size = NumberSequence.new(0.6, 1.2)
    emitter.Lifetime = NumberRange.new(FootprintLifetime, FootprintLifetime + 0.2)
    emitter.Rate = 40
    emitter.Speed = NumberRange.new(1, 3)
    if FootprintShape == "Circle" then
        emitter.SpreadAngle = Vector2.new(360, 360)
    elseif FootprintShape == "Square" then
        emitter.SpreadAngle = Vector2.new(90, 90)
    else
        emitter.SpreadAngle = Vector2.new(30, 30)
    end
    emitter.EmissionDirection = Enum.NormalId.Top
    emitter.VelocityInheritance = 0
    emitter.Parent = attachment
    emitter.Enabled = true
    table.insert(FootprintEmitters, {attachment = attachment, emitter = emitter})
    task.delay(FootprintLifetime + 0.5, function()
        if attachment then attachment:Destroy() end
        if emitter then emitter:Destroy() end
    end)
end

local function UpdateFootprints(character)
    if not FootprintsEnabled then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end
    if root.AssemblyLinearVelocity.Magnitude < 2 then return end
    local now = tick()
    if now - lastFootprintTime >= FootprintDensity then
        lastFootprintTime = now
        CreateFootprint(root.Position - Vector3.new(0, 3, 0))
    end
end

-- ================== CHARACTER HANDLING ==================
local function OnCharacterAdded(character)
    task.wait(1)
    if WingsEnabled then UpdateWings() end
    SetupJumpDetection(character)
    local footprintConn = RunService.Heartbeat:Connect(function()
        if character and character:IsDescendantOf(workspace) then
            UpdateFootprints(character)
        else
            footprintConn:Disconnect()
        end
    end)
    table.insert(connections, footprintConn)
    applyPCEffects()
end

if LocalPlayer then
    LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
    if LocalPlayer.Character then
        task.spawn(OnCharacterAdded, LocalPlayer.Character)
    end
end

