-- ВАША ОРИГИНАЛЬНАЯ ИСПРАВЛЕННАЯ ЛОГИКА SKYBOX + УСИЛЕННЫЙ СВЕТ КАРТЫ
local function RefreshEnvironment()
    if _skyboxApplying then return end
    _skyboxApplying = true
    
    -- Очищаем Atmosphere и Clouds (чтобы туман ложился идеально)
    for _, obj in pairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") or obj:IsA("Clouds") then
            obj:Destroy()
        end
    end
    
    -- Логика Скайбокса
    if SkyboxEnabled and CurrentPreset ~= "Default" then
        local presetData = SkyboxPresets[CurrentPreset]
        if presetData then
            local currentSky = Lighting:FindFirstChildOfClass("Sky")
            if not currentSky then
                currentSky = Instance.new("Sky")
                currentSky.Parent = Lighting
            end
            
            currentSky.SkyboxBk = presetData.SkyboxBk
            currentSky.SkyboxDn = presetData.SkyboxDn
            currentSky.SkyboxFt = presetData.SkyboxFt
            currentSky.SkyboxLf = presetData.SkyboxLf
            currentSky.SkyboxRt = presetData.SkyboxRt
            currentSky.SkyboxUp = presetData.SkyboxUp
            currentSky.StarCount = SkySettings.StarCount
            currentSky.SunAngularSize = SkySettings.SunAngularSize
            currentSky.MoonAngularSize = SkySettings.MoonAngularSize
            currentSky.CelestialBodiesShown = SkySettings.CelestialBodiesShown
            
            if CustomFogEnabled then
                currentSky.CelestialBodiesShown = false
            end
            
            -- ИЗМЕНЕНО: Тотальная заливка всей карты под выбранную тему (Outdoor, Сдвиги цвета)
            Lighting.ClockTime = presetData.ClockTime
            Lighting.Brightness = presetData.Brightness
            Lighting.ExposureCompensation = presetData.Exposure
            Lighting.Ambient = presetData.Ambient
            Lighting.OutdoorAmbient = presetData.Outdoor
            Lighting.ColorShift_Top = presetData.Top or Color3.fromRGB(0,0,0)
            Lighting.ColorShift_Bottom = presetData.Bottom or Color3.fromRGB(0,0,0)
        end
    else
        -- Чистый сброс к вашей сохраненной таблице DefaultLighting
        for _, obj in pairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") then 
                obj:Destroy() 
            end
        end
        Lighting.Brightness = DefaultLighting.Brightness
        Lighting.ExposureCompensation = DefaultLighting.ExposureCompensation
        Lighting.Ambient = DefaultLighting.Ambient
        Lighting.OutdoorAmbient = DefaultLighting.OutdoorAmbient
        Lighting.ColorShift_Top = DefaultLighting.DefaultColorShiftTop or DefaultLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = DefaultLighting.DefaultColorShiftBottom or DefaultLighting.ColorShift_Bottom
        Lighting.ClockTime = DefaultLighting.ClockTime
    end
    
    -- Логика Тумана
    if CustomFogEnabled then
        Lighting.FogStart = 0
        Lighting.FogEnd = FogEndDist
        Lighting.FogColor = FogColorRGB
        Lighting.Ambient = FogColorRGB:Lerp(Lighting.Ambient, 0.2)
        Lighting.OutdoorAmbient = FogColorRGB:Lerp(Lighting.OutdoorAmbient, 0.1)
    else
        Lighting.FogStart = DefaultLighting.FogStart
        Lighting.FogEnd = DefaultLighting.FogEnd
        Lighting.FogColor = DefaultLighting.FogColor
    end
    _skyboxApplying = false
end

-- НАДЁЖНАЯ ЛОГИКА ЧАСТИЦ (PARTICLES)
local MovementEmitter = nil
local EnvironmentEmitter = nil
local EnvironmentAttachment = nil

local function UpdateParticles()
    if MovementEmitter then MovementEmitter:Destroy() MovementEmitter = nil end
    if EnvironmentEmitter then EnvironmentEmitter:Destroy() EnvironmentEmitter = nil end
    if EnvironmentAttachment then EnvironmentAttachment:Destroy() EnvironmentAttachment = nil end
    
    if not ParticlesEnabled or not LocalPlayer.Character then return end
    
    local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    
    local currentTexture = ParticleTextures[ParticlesShape] or ParticleTextures["Snowflake"]
    
    if ParticlesMode == "On Move/Jump" then
        MovementEmitter = Instance.new("ParticleEmitter")
        MovementEmitter.Texture = currentTexture
        MovementEmitter.Color = ColorSequence.new(ParticlesColor)
        MovementEmitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0)})
        MovementEmitter.Lifetime = NumberRange.new(0.6, 1.2)
        MovementEmitter.Rate = 0
        MovementEmitter.Speed = NumberRange.new(3, 6)
        MovementEmitter.SpreadAngle = Vector2.new(180, 180)
        MovementEmitter.Parent = root
        
        local moveConn
        moveConn = RunService.Heartbeat:Connect(function()
            if not ParticlesEnabled or not MovementEmitter or not MovementEmitter.Parent then
                if moveConn then 
                    moveConn:Disconnect() 
                end
                return
            end
            if root.AssemblyLinearVelocity.Magnitude > 2 then
                MovementEmitter.Rate = 40
            else
                MovementEmitter.Rate = 0
            end
        end)
        table.insert(connections, moveConn)
        
    elseif ParticlesMode == "Snowflakes" then
        EnvironmentAttachment = Instance.new("Attachment")
        EnvironmentAttachment.Position = Vector3.new(0, 12, 0)
        EnvironmentAttachment.Parent = root
        
        EnvironmentEmitter = Instance.new("ParticleEmitter")
        EnvironmentEmitter.Texture = currentTexture
        EnvironmentEmitter.Color = ColorSequence.new(ParticlesColor)
        EnvironmentEmitter.Size = NumberSequence.new(0.5, 1.0)
        EnvironmentEmitter.Lifetime = NumberRange.new(2.5, 4)
        EnvironmentEmitter.Rate = 50
        EnvironmentEmitter.Speed = NumberRange.new(4, 8)
        EnvironmentEmitter.EmissionDirection = Enum.NormalId.Bottom
        EnvironmentEmitter.SpreadAngle = Vector2.new(60, 60)
        EnvironmentEmitter.Parent = EnvironmentAttachment
    end
end
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if ParticlesEnabled then 
        UpdateParticles() 
    end
end)

